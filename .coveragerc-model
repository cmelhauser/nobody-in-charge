# Coverage configuration for the version legs, which run only the model tests, the release
# invariants and the direct tool tests, and so can hold the canonical model to 100 per cent
# but cannot hold the tools to it: the tools are exercised mostly by running them as
# subprocesses, which only the full suite on 3.12 does. `.coveragerc` is the full gate.
#
# SCOPE. This file gates `model/aa_group_model.py`, the canonical model, at 100 per cent. That
# file is the one the whole project rests on: it is hash-frozen at the release digest, every
# cache is linked to it, and its semantics are what the manuscript, the paper and the primer
# describe. It is pure computation with no I/O and is therefore both worth testing
# exhaustively and cheap to test.
#
# The scripts under `tools/` are held to 100 per cent too, but only by `.coveragerc`, which the
# full suite on 3.12 uses because it follows the tools' subprocess runs. The analysis scripts
# under `model/` other than the canonical model are outside both gates: they are batch Monte
# Carlo jobs, and their bytes are frozen (each records its SHA-256 in its cache), so a test hook
# or a pragma would invalidate hours of computation. The release gate verifies them instead.
#
# `model/aa_group_model.py` cannot carry `# pragma: no cover` comments, because editing
# the file at all changes its SHA-256 and invalidates the release. The single
# unreachable line is therefore excluded by pattern below, with its justification.
[run]
branch = False
include =
    model/aa_group_model.py

[report]
show_missing = True
skip_covered = False
fail_under = 100
exclude_also =
    # Defensive re-check of closure after the arrival draw in simulate(). It cannot
    # execute: the loop breaks on alive.sum() == 0 before arrivals are drawn, so
    # n_after is always at least one by the time this line is reached. Verified by
    # reading model/aa_group_model.py lines 262 to 291.
    if n_after == 0 and closure_week is None:
    # Script entry points are exercised by running the module, not by importing it.
    if __name__ == .__main__.:
