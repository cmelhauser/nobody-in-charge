% Shared style for the governance-matrix elicitation packet.
% Matches the book's typeface (TeX Gyre Pagella) so the packet reads as part of
% the same project. Nothing here is decorative for its own sake: the grid needs
% tall cells because respondents write in it by hand, and the collator notes need
% a warning that cannot be skimmed past.
\ProvidesPackage{elicitation}

\RequirePackage{amssymb}
\RequirePackage{fontspec}
\RequirePackage[a4paper,margin=25mm,top=24mm,bottom=24mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{microtype}
\RequirePackage[most]{tcolorbox}
\RequirePackage{parskip}
\RequirePackage[hidelinks]{hyperref}

\setmainfont{TeX Gyre Pagella}

\definecolor{ink}{HTML}{1A1A1A}
\definecolor{rule}{HTML}{9A9A9A}
\definecolor{shade}{HTML}{F2F0EC}
\definecolor{warn}{HTML}{8C2A18}
\color{ink}

\titleformat{\section}{\large\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{16pt}{6pt}
\titleformat{\subsection}{\bfseries}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\footnotesize\color{rule}\thepage}

% Title block. #1 title, #2 standfirst.
\newcommand{\packettitle}[2]{%
  \begin{center}
    {\LARGE\bfseries #1}\\[5pt]
    {\color{rule}\rule{0.32\linewidth}{0.6pt}}\\[7pt]
    {\itshape #2}
  \end{center}
  \vspace{4pt}
}

% A quiet callout for things the reader must not miss.
\newtcolorbox{note}[1][]{
  colback=shade, colframe=rule, boxrule=0.4pt, arc=1.5pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt, #1}

\newtcolorbox{warning}{
  colback=warn!6, colframe=warn, boxrule=1pt, arc=1.5pt,
  left=8pt, right=8pt, top=7pt, bottom=7pt}

% Ruled writing space.
\newcommand{\answerlines}[1][3]{%
  \vspace{2pt}
  \foreach \i in {1,...,#1}{\noindent\color{rule}\rule{\linewidth}{0.4pt}\\[9pt]}%
  \vspace{-9pt}}
\RequirePackage{tikz}

% The twelve-by-eight grid. Cells are 9mm tall so a pen fits.
\newcolumntype{G}{>{\centering\arraybackslash}m{12mm}}
\newcommand{\gridhead}[1]{\rotatebox{60}{\small\bfseries #1}}

% Checkbox for the yes/no questions.
\newcommand{\checkbox}{\raisebox{-0.5pt}{\framebox[9pt]{\rule{0pt}{7pt}}}}
